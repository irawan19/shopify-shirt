{%- comment -%}
  Reusable premium product card.
  Usage: {% render 'product-card-inline', product: product %}
  CSS lives in assets/base.css (not duplicated per card).
{%- endcomment -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price and product.available -%}
  {%- assign on_sale = true -%}
{%- endif -%}
{%- assign sold_out = false -%}
{%- unless product.available -%}
  {%- assign sold_out = true -%}
{%- endunless -%}
{%- assign second_image = product.media[1] -%}

<a href="{{ product.url }}" class="pcard reveal"{% if second_image %} data-has-hover="true"{% endif %}>
  <div class="pcard__media">
    {%- if product.featured_media -%}
      <img class="pcard__img pcard__img--main"
        src="{{ product.featured_media | image_url: width: 500 }}"
        srcset="{{ product.featured_media | image_url: width: 250 }} 250w, {{ product.featured_media | image_url: width: 400 }} 400w, {{ product.featured_media | image_url: width: 500 }} 500w"
        sizes="(min-width: 1024px) 23vw, (min-width: 640px) 48vw, 48vw"
        alt="{{ product.featured_media.alt | default: product.title | escape }}"
        loading="lazy">
      {%- if second_image -%}
        <img class="pcard__img pcard__img--hover"
          src="{{ second_image | image_url: width: 500 }}"
          alt="{{ second_image.alt | default: product.title | escape }}"
          loading="lazy">
      {%- endif -%}
    {%- else -%}
      <div class="pcard__no-img">
        <span>No Image</span>
      </div>
    {%- endif -%}

    {%- if sold_out -%}
      <span class="pcard__badge pcard__badge--soldout">Sold Out</span>
    {%- elsif on_sale -%}
      <span class="pcard__badge pcard__badge--sale">Sale</span>
    {%- elsif product.tags contains 'New' or product.tags contains 'new' -%}
      <span class="pcard__badge pcard__badge--new">New</span>
    {%- endif -%}

    <div class="pcard__action">
      <span>View Product &rarr;</span>
    </div>
  </div>

  <div class="pcard__body">
    <h3 class="pcard__title">{{ product.title }}</h3>
    <p class="pcard__price">
      {%- if on_sale -%}
        <span class="pcard__price--old">{{ product.compare_at_price | money }}</span>{{ product.price | money }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </p>
  </div>
</a>
