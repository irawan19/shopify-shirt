<div class="collections-list page-padding" style="padding-top: 96px; padding-bottom: var(--section-gap);">
  <header class="collections-list__head" style="margin-bottom: 64px; text-align: center; border-bottom: 1px solid var(--color-primary); padding-bottom: 48px;">
    <h1 class="display-lg">COLLECTIONS</h1>
    <p class="label-caps text-muted" style="margin-top: 16px; letter-spacing: 0.2em;">EXPLORE ALL {{ shop.name | upcase }} DROPS</p>
  </header>
  <div class="grid-products">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-showcase">
        <div class="collection-showcase__media">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 800 }}"
              srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 600 }} 600w, {{ collection.featured_image | image_url: width: 800 }} 800w"
              sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
              alt="{{ collection.title | escape }}" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: '' }}
          {%- endif -%}
          <div class="collection-showcase__overlay"></div>
          <div class="collection-showcase__caption">
            <h3 class="collection-showcase__title">{{ collection.title }}</h3>
            <span class="collection-showcase__cta">{{ collection.products_count }} T-SHIRTS</span>
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>
