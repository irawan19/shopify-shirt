{%- comment -%} Homepage — premium black & white, cinematic, full sections. No schema. {%- endcomment -%}
<main class="w-full" style="padding: 0;">

  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <section class="hero-section" style="position:relative; width:100%; height:70vh; min-height:520px; max-height:780px; display:flex; flex-direction:column; justify-content:flex-end; overflow:hidden; background:#0a0a0a;">
    <div class="hero-section__media image-reveal" style="position:absolute; inset:0; z-index:0; overflow:hidden;">
      {%- if settings.hero_image != blank -%}
        <img src="{{ settings.hero_image | image_url: width: 2400 }}"
          alt="Hero"
          style="width:100%; height:100%; object-fit:cover; object-position:center; filter:grayscale(0.3) brightness(0.7);">
      {%- else -%}
        <img src="{{ 'hero-default.jpg' | asset_url }}"
          alt="Outdoor apparel — made to explore"
          style="width:100%; height:100%; object-fit:cover; object-position:center 30%; filter:grayscale(0.4) brightness(0.6) contrast(1.1);">
      {%- endif -%}
      <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 40%, transparent 70%);"></div>
    </div>
    <div class="hero-fade-in" style="position:relative; z-index:10; width:100%; padding:0 20px 48px; box-sizing:border-box;">
      <div style="max-width:640px;">
        <p style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:#fff; margin:0 0 16px; opacity:0.8;">{{ shop.name | upcase }} / OUTDOOR T-SHIRTS</p>
        <h1 style="font-family:'EB Garamond',serif; font-size:44px; line-height:1.05; color:#fff; margin:0 0 28px; font-weight:400; letter-spacing:-0.01em;">MADE TO EXPLORE</h1>
        <div style="display:flex; flex-direction:row; gap:12px; flex-wrap:wrap;">
          <a href="{{ routes.all_products_collection_url }}" class="btn-cinematic" style="background:#fff; color:#000; padding:14px 32px; font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; text-decoration:none; display:inline-block;">SHOP T-SHIRTS</a>
          <a href="#categories" style="background:transparent; color:#fff; border:1px solid rgba(255,255,255,0.4); padding:14px 32px; font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; text-decoration:none; display:inline-block; transition:border-color 0.3s ease, background 0.3s ease;" onmouseover="this.style.borderColor='#fff';this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.4)';this.style.background='transparent'">EXPLORE COLLECTIONS</a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============ DETECT REAL CATEGORIES (exclude 'all' and 'frontpage') ============ {%- endcomment -%}
  {%- assign real_collections = '' | split: '' -%}
  {%- for col in collections -%}
    {%- if col.handle != 'all' and col.handle != 'frontpage' -%}
      {%- assign real_collections = real_collections | push: col -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign has_categories = false -%}
  {%- if real_collections.size > 0 -%}{%- assign has_categories = true -%}{%- endif -%}

  {%- assign all_products = collections.all.products | default: collections.first.products -%}

  {%- comment -%} ============ CATEGORIES (only if real categories exist) ============ {%- endcomment -%}
  {%- if has_categories -%}
  {%- assign sorted_collections = real_collections | sort: 'title' -%}
  <section id="categories" style="padding: 80px 20px;">
    <div class="reveal" style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:1px solid #e5e5e5; padding-bottom:16px; margin-bottom:36px;">
      <div>
        <p style="font-family:'Geist',sans-serif; font-size:10px; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:#888; margin:0 0 8px;">BROWSE BY</p>
        <h2 style="font-family:'EB Garamond',serif; font-size:28px; line-height:1.2; color:#000; margin:0; font-weight:400; letter-spacing:-0.01em;">CATEGORIES</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="link-underline" style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#000; text-decoration:none;">VIEW ALL</a>
    </div>

    <div class="product-grid reveal-stagger" style="grid-template-columns: repeat(2, 1fr);">
      {%- for col in sorted_collections limit: 4 -%}
        <a href="{{ col.url }}" class="pcard reveal" style="text-decoration:none; color:inherit; display:block;">
          <div class="pcard__media" style="aspect-ratio: 4/3;">
            {%- if col.image -%}
              <img class="pcard__img pcard__img--main" src="{{ col.image | image_url: width: 600 }}"
                srcset="{{ col.image | image_url: width: 300 }} 300w, {{ col.image | image_url: width: 600 }} 600w"
                sizes="(min-width: 1024px) 48vw, 48vw"
                alt="{{ col.title | escape }}" loading="lazy"
                style="object-fit:cover;">
            {%- else -%}
              <div class="pcard__no-img"><span>{{ col.title | upcase }}</span></div>
            {%- endif -%}
            <div class="pcard__action"><span>{{ col.title | upcase }} &rarr;</span></div>
          </div>
          <div class="pcard__body">
            <h3 class="pcard__title" style="font-size:18px;">{{ col.title }}</h3>
            <p class="pcard__price" style="color:#888;">{{ col.products_count }} PRODUCTS</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ============ NEW ARRIVALS (always show if products exist) ============ {%- endcomment -%}
  {%- if all_products.size > 0 -%}
  <section style="padding: 80px 20px;">
    <div class="reveal" style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:1px solid #e5e5e5; padding-bottom:16px; margin-bottom:36px;">
      <div>
        <p style="font-family:'Geist',sans-serif; font-size:10px; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:#888; margin:0 0 8px;">FRESH DROPS</p>
        <h2 style="font-family:'EB Garamond',serif; font-size:28px; line-height:1.2; color:#000; margin:0; font-weight:400; letter-spacing:-0.01em;">NEW ARRIVALS</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending" class="link-underline" style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#000; text-decoration:none;">VIEW ALL</a>
    </div>

    <div class="product-grid reveal-stagger">
      {%- assign sorted_new = all_products | sort: 'created_at' | reverse -%}
      {%- for product in sorted_new limit: 4 -%}
        {% render 'product-card-inline', product: product %}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ============ BEST SELLERS (always show if products exist) ============ {%- endcomment -%}
  {%- if all_products.size > 0 -%}
  <section style="padding: 80px 20px; background: #fafafa;">
    <div class="reveal" style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:1px solid #e5e5e5; padding-bottom:16px; margin-bottom:36px;">
      <div>
        <p style="font-family:'Geist',sans-serif; font-size:10px; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:#888; margin:0 0 8px;">TRENDING NOW</p>
        <h2 style="font-family:'EB Garamond',serif; font-size:28px; line-height:1.2; color:#000; margin:0; font-weight:400; letter-spacing:-0.01em;">BEST SELLERS</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}?sort_by=best-selling" class="link-underline" style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#000; text-decoration:none;">VIEW ALL</a>
    </div>

    <div class="product-grid reveal-stagger">
      {%- assign sorted_best = all_products | sort: 'price' -%}
      {%- for product in sorted_best limit: 4 -%}
        {% render 'product-card-inline', product: product %}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ============ ALL PRODUCTS (show when no categories, or always as full listing) ============ {%- endcomment -%}
  {%- if all_products.size > 0 and has_categories == false -%}
  <section style="padding: 80px 20px;">
    <div class="reveal" style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:1px solid #e5e5e5; padding-bottom:16px; margin-bottom:36px;">
      <div>
        <p style="font-family:'Geist',sans-serif; font-size:10px; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:#888; margin:0 0 8px;">SHOP ALL</p>
        <h2 style="font-family:'EB Garamond',serif; font-size:28px; line-height:1.2; color:#000; margin:0; font-weight:400; letter-spacing:-0.01em;">ALL PRODUCTS</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="link-underline" style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#000; text-decoration:none;">VIEW ALL</a>
    </div>

    <div class="product-grid reveal-stagger">
      {%- for product in all_products limit: 8 -%}
        {% render 'product-card-inline', product: product %}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ============ BRAND STORY (editorial) ============ {%- endcomment -%}
  <section style="padding: 80px 20px; background:#0a0a0a; color:#fff;">
    <div class="reveal" style="max-width:800px; margin:0 auto; text-align:center;">
      <p style="font-family:'Geist',sans-serif; font-size:10px; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.5); margin:0 0 24px;">OUR PHILOSOPHY</p>
      <h2 style="font-family:'EB Garamond',serif; font-size:36px; line-height:1.3; color:#fff; margin:0 0 24px; font-weight:400; letter-spacing:-0.01em;">Built for those who wander beyond the map.</h2>
      <p style="font-family:'Geist',sans-serif; font-size:15px; line-height:1.7; color:rgba(255,255,255,0.7); margin:0 0 32px;">Every piece is crafted with intention — premium fabrics, technical precision, and a minimalist aesthetic that performs as well in the city as it does on the trail.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-cinematic" style="background:#fff; color:#000; padding:14px 32px; font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; text-decoration:none; display:inline-block;">DISCOVER THE COLLECTION</a>
    </div>
  </section>

</main>

<style>
  @media (min-width: 768px) {
    .hero-section { height: 780px !important; max-height: 780px !important; }
    .hero-section h1 { font-size: 64px !important; }
    .hero-section > div:last-child { padding: 0 64px 64px !important; }
    main > section { padding-left: 64px !important; padding-right: 64px !important; }
  }
</style>

<script>
  (function() {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal, .reveal-stagger').forEach(function(el) {
      observer.observe(el);
    });
  })();
</script>
