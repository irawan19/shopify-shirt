{%- comment -%} Collection page — sidebar categories, price range, sort. No schema. {%- endcomment -%}
{%- paginate collection.products by 24 -%}
<main class="collection-page" style="padding: 0;">

  {%- comment -%} Collection Header {%- endcomment -%}
  <header class="reveal" style="text-align:center; padding: 64px 20px; border-bottom:1px solid #e5e5e5;">
    <h1 style="font-family:'EB Garamond',serif; font-size:36px; line-height:1.1; color:#000; margin:0 0 12px; font-weight:400; letter-spacing:-0.01em;">{{ collection.title | default: 'ALL T-SHIRTS' | upcase }}</h1>
    <p style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:#888; margin:0;">
      {%- if collection.description != blank -%}
        {{ collection.description | strip_html | truncatewords: 12 | upcase }}
      {%- else -%}
        THE COMPLETE {{ shop.name | upcase }} COLLECTION
      {%- endif -%}
    </p>
  </header>

  {%- comment -%} Layout: sidebar + products {%- endcomment -%}
  <div class="collection-layout" style="display:grid; grid-template-columns:1fr; gap:0;">

    {%- comment -%} ===== SIDEBAR (left) ===== {%- endcomment -%}
    <aside class="collection-sidebar" style="border-right:1px solid #e5e5e5; padding:32px 20px; overflow-x:hidden; box-sizing:border-box;">

      {%- comment -%} Categories — vertical list, no horizontal scroll {%- endcomment -%}
      <div class="sidebar-section" style="margin-bottom:40px; overflow:hidden;">
        <h3 style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:#000; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid #e5e5e5;">CATEGORIES</h3>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:4px; overflow:hidden;">
          <li>
            <a href="{{ routes.all_products_collection_url }}" class="sidebar-cat-link{% if collection.handle == 'all' %} is-active{% endif %}" style="display:block; padding:8px 0; font-family:'Geist',sans-serif; font-size:13px; color:{% if collection.handle == 'all' %}#000{% else %}#666{% endif %}; text-decoration:none; font-weight:{% if collection.handle == 'all' %}600{% else %}400{% endif %}; transition:color 0.2s ease; white-space:normal; word-break:break-word;">
              <span>All Products</span>
              <span style="font-family:'Geist Mono',monospace; font-size:11px; color:#999; margin-left:8px;">({{ collections.all.products_count }})</span>
            </a>
          </li>
          {%- for col in collections -%}
            {%- if col.handle != 'all' and col.handle != 'frontpage' -%}
            <li>
              <a href="{{ col.url }}" class="sidebar-cat-link{% if collection.handle == col.handle %} is-active{% endif %}" style="display:block; padding:8px 0; font-family:'Geist',sans-serif; font-size:13px; color:{% if collection.handle == col.handle %}#000{% else %}#666{% endif %}; text-decoration:none; font-weight:{% if collection.handle == col.handle %}600{% else %}400{% endif %}; transition:color 0.2s ease; white-space:normal; word-break:break-word;">
                <span>{{ col.title }}</span>
                <span style="font-family:'Geist Mono',monospace; font-size:11px; color:#999; margin-left:8px;">({{ col.products_count }})</span>
              </a>
            </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Price Range — stacked min/max inputs (vertical) {%- endcomment -%}
      <div class="sidebar-section" style="margin-bottom:40px; overflow:hidden;">
        <h3 style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:#000; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid #e5e5e5;">PRICE RANGE</h3>
        <form action="{{ collection.url }}" method="get" style="display:flex; flex-direction:column; gap:12px;">
          {%- if collection.current_vendor != blank -%}<input type="hidden" name="filter.p.vendor" value="{{ collection.current_vendor }}">{%- endif -%}
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label for="price-min" style="font-family:'Geist Mono',monospace; font-size:11px; color:#666;">MIN PRICE</label>
            <input type="number" id="price-min" name="filter.v.price.gte" placeholder="Min" min="0" step="0.01" style="width:100%; box-sizing:border-box; padding:8px 12px; border:1px solid #e5e5e5; font-family:'Geist Mono',monospace; font-size:12px; color:#000; background:#fff;">
          </div>
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label for="price-max" style="font-family:'Geist Mono',monospace; font-size:11px; color:#666;">MAX PRICE</label>
            <input type="number" id="price-max" name="filter.v.price.lte" placeholder="Max" min="0" step="0.01" style="width:100%; box-sizing:border-box; padding:8px 12px; border:1px solid #e5e5e5; font-family:'Geist Mono',monospace; font-size:12px; color:#000; background:#fff;">
          </div>
          <button type="submit" style="width:100%; padding:10px; background:#000; color:#fff; border:none; font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; cursor:pointer; transition:opacity 0.2s ease;">APPLY FILTER</button>
        </form>
      </div>

      {%- comment -%} Product Type Filter {%- endcomment -%}
      {%- assign types = collection.all_types | sort -%}
      {%- if types.size > 0 -%}
      <div class="sidebar-section" style="margin-bottom:40px;">
        <h3 style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:#000; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid #e5e5e5;">PRODUCT TYPE</h3>
        <ul style="list-style:none; padding:0; margin:0;">
          {%- for type in types -%}
            {%- if type != blank -%}
            <li style="margin-bottom:8px;">
              <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-family:'Geist',sans-serif; font-size:13px; color:#666;">
                <input type="checkbox" name="filter.p.product_type" value="{{ type }}" style="accent-color:#000;">
                <span>{{ type }}</span>
              </label>
            </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}

      {%- comment -%} Availability {%- endcomment -%}
      <div class="sidebar-section">
        <h3 style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:#000; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid #e5e5e5;">AVAILABILITY</h3>
        <ul style="list-style:none; padding:0; margin:0;">
          <li style="margin-bottom:8px;">
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-family:'Geist',sans-serif; font-size:13px; color:#666;">
              <input type="checkbox" name="filter.v.availability" value="1" style="accent-color:#000;">
              <span>In Stock</span>
            </label>
          </li>
        </ul>
      </div>

    </aside>

    {%- comment -%} ===== PRODUCTS (right) ===== {%- endcomment -%}
    <div class="collection-main" style="padding:32px 20px;">

      {%- comment -%} Sort Bar {%- endcomment -%}
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:32px; padding-bottom:16px; border-bottom:1px solid #e5e5e5;">
        <p style="font-family:'Geist Mono',monospace; font-size:12px; color:#888; margin:0;">{{ collection.products_count }} PRODUCTS</p>
        <div style="display:flex; align-items:center; gap:12px;">
          <span style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:#888;">SORT:</span>
          <select id="sort-select" name="sort_by" style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; background:transparent; border:none; cursor:pointer; outline:none; appearance:none; padding-right:20px; color:#000;">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by or option.value == collection.default_sort_by %}selected{% endif %}>{{ option.name | upcase }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      {%- comment -%} Active filters {%- endcomment -%}
      {%- assign has_active = false -%}
      {%- for filter in collection.filters -%}
        {%- for value in filter.values -%}
          {%- if value.active -%}
            {%- assign has_active = true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}

      {%- comment -%} Product Grid {%- endcomment -%}
      <div class="collection-grid-products reveal-stagger">

        {%- if collection.products_count > 0 -%}
          {%- for product in collection.products -%}
            {% render 'product-card-inline', product: product %}
          {%- endfor -%}
        {%- else -%}
          <div style="grid-column:1/-1; padding:96px 20px; text-align:center;">
            <p style="font-family:'EB Garamond',serif; font-size:24px; color:#000; margin:0 0 8px;">No products found</p>
            <p style="font-family:'Geist Mono',monospace; font-size:12px; color:#888; margin:0;">Try adjusting your filters</p>
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} Pagination {%- endcomment -%}
      {%- if paginate.pages > 1 -%}
      <nav style="padding:48px 0 32px; display:flex; justify-content:center; gap:12px; align-items:center;">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="link-underline" style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:#000; text-decoration:none;">&larr; PREV</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" style="font-family:'Geist Mono',monospace; font-size:12px; color:#888; text-decoration:none; padding:4px 8px; transition:color 0.2s;" onmouseover="this.style.color='#000'" onmouseout="this.style.color='#888'">{{ part.title }}</a>
          {%- else -%}
            <span style="font-family:'Geist Mono',monospace; font-size:12px; color:#000; font-weight:700; border-bottom:2px solid #000; padding:4px 8px;">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="link-underline" style="font-family:'Geist',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:#000; text-decoration:none;">NEXT &rarr;</a>
        {%- endif -%}
      </nav>
      {%- endif -%}

    </div>
  </div>
</main>

<style>
  /* Ensure sidebar never causes horizontal scroll */
  .collection-sidebar { box-sizing: border-box; overflow-x: hidden; max-width: 100%; }
  .collection-sidebar input[type="number"],
  .collection-sidebar button { box-sizing: border-box; max-width: 100%; }
  .sidebar-cat-link:hover { color: #000 !important; }

  /* Desktop: sidebar + products */
  @media (min-width: 1024px) {
    .collection-layout { grid-template-columns: 240px 1fr !important; }
    .collection-sidebar { position: sticky; top: 72px; height: fit-content; max-height: calc(100vh - 72px); overflow-y: auto; overflow-x: hidden; padding: 40px 20px !important; }
    .collection-main { padding: 40px 48px !important; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .collection-layout { grid-template-columns: 200px 1fr !important; }
    .collection-sidebar { padding: 32px 12px !important; }
    .collection-main { padding: 32px 20px !important; }
  }
  /* Mobile: sidebar collapses above products */
  @media (max-width: 767px) {
    .collection-sidebar { border-right: none !important; border-bottom: 1px solid #e5e5e5; }
  }
  @media (min-width: 768px) {
    .collection-page header { padding: 80px 64px !important; }
  }
</style>

<script>
  (function() {
    // Sort select
    var sortSelect = document.getElementById('sort-select');
    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', this.value);
        window.location.href = url.toString();
      });
    }

    // Checkbox filters auto-submit
    document.querySelectorAll('.collection-sidebar input[type="checkbox"]').forEach(function(cb) {
      cb.addEventListener('change', function() {
        var url = new URL(window.location.href);
        var name = this.name;
        var value = this.value;
        if (this.checked) {
          url.searchParams.append(name, value);
        } else {
          var params = url.searchParams.getAll(name);
          url.searchParams.delete(name);
          params.forEach(function(p) {
            if (p !== value) url.searchParams.append(name, p);
          });
        }
        window.location.href = url.toString();
      });
    });

    // Scroll reveal
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal, .reveal-stagger').forEach(function(el) {
      observer.observe(el);
    });
  })();
</script>
{%- endpaginate -%}
