<article class="page-default page-padding" style="padding-top: 96px; padding-bottom: var(--section-gap);">
  <header class="page-default__head" style="max-width: 48rem;">
    <h1 class="headline-xl">{{ page.title }}</h1>
  </header>
  {%- if page.content != blank -%}
    <div class="rte page-default__content" style="margin-top: 48px;">{{ page.content }}</div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
