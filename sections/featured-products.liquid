<section class="featured-products">
  <div class="featured-products__inner page-padding">
    <div class="featured-products__head">
      <h2 class="featured-products__title">{{ section.settings.heading | default: 'DROP 01 / 2026' }}</h2>
      {%- if section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}" class="label-caps featured-products__link">{{ section.settings.view_all_label | default: 'VIEW ALL' }}</a>
      {%- endif -%}
    </div>

    {%- assign source = section.settings.collection -%}
    {%- assign products = nil -%}
    {%- if source != blank and source.products_count > 0 -%}
      {%- assign products = source.products -%}
    {%- elsif section.settings.collection == blank -%}
      {%- if collections.all != blank -%}
        {%- assign products = collections.all.products -%}
      {%- elsif collections.size > 0 -%}
        {%- assign products = collections.first.products -%}
      {%- endif -%}
    {%- endif -%}

    <div class="grid-products">
      {%- for product in products limit: section.settings.product_count -%}
        {% render 'product-card', product: product, show_swatches: false %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-image-main' }}</div>
            <h3 class="product-card__title">Sample Tee</h3>
            <p class="product-card__meta mono-ui">$65 / 100% ORGANIC COTTON</p>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "DROP 01 / 2026" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range", "id": "product_count", "label": "Product count", "min": 4, "max": 12, "step": 4, "default": 4
    },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "VIEW ALL" },
    { "type": "url", "id": "view_all_url", "label": "View all URL" }
  ],
  "presets": [
    { "name": "Featured products" }
  ]
}
{% endschema %}
