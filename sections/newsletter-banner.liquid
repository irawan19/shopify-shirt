<section class="newsletter-banner">
  <div class="newsletter-banner__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="body-lg text-muted">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- form 'customer', class: 'newsletter-banner__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      <input type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t | upcase }}" class="newsletter-banner__input" aria-label="{{ 'newsletter.placeholder' | t }}" required>
      <button type="submit" class="newsletter-banner__btn" aria-label="{{ 'newsletter.button' | t }}">
        {% render 'icon', name: 'arrow_forward', size: 20 %}
      </button>
      {%- if form.posted_successfully? -%}
        <p class="mono-ui text-coffee">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "JOIN THE EXPEDITION" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe to receive updates, access to exclusive deals, and more." }
  ],
  "presets": [
    { "name": "Newsletter banner" }
  ]
}
{% endschema %}
