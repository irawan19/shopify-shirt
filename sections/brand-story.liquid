<section class="brand-story page-padding">
  <div class="brand-story__grid">
    <div class="brand-story__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label-caps text-muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="body-lg text-muted">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.settings.specs != blank -%}
        <p class="brand-story__list">{{ section.settings.specs | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url | default: routes.pages_url }}" class="btn btn--secondary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="brand-story__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 768px) 58vw, 100vw"
          alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: '' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "OUTDOOR T-SHIRTS FOR THE MODERN EXPLORER." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "We engineer technical apparel that rejects the rugged tropes of traditional outdoor gear. Our pieces are designed with architectural precision, utilizing advanced fabric technologies wrapped in a minimalist, gallery-worthy aesthetic." },
    { "type": "textarea", "id": "specs", "label": "Specs list (one per line)", "default": "01. BREATHABILITY\n02. DURABILITY\n03. SILHOUETTE" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "READ OUR STORY" },
    { "type": "url", "id": "button_url", "label": "Button URL" }
  ],
  "presets": [
    { "name": "Brand story" }
  ]
}
{% endschema %}
