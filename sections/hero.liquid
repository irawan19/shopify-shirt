<section class="hero" style="height: {{ section.settings.height_mobile }}px;">
  <style>
    @media (min-width: 768px) { .hero { height: {{ section.settings.height_desktop }}px !important; } }
  </style>
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {%- assign img = section.settings.image -%}
      <img src="{{ img | image_url: width: 2400 }}"
        srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w, {{ img | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
        width="{{ img.width }}" height="{{ img.height }}"
        fetchpriority="high"
        class="hero__img">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__img hero__placeholder' }}
    {%- endif -%}
    {%- if section.settings.mobile_image != blank -%}
      {%- assign mimg = section.settings.mobile_image -%}
      <img src="{{ mimg | image_url: width: 800 }}"
        srcset="{{ mimg | image_url: width: 400 }} 400w, {{ mimg | image_url: width: 600 }} 600w, {{ mimg | image_url: width: 800 }} 800w"
        sizes="100vw"
        alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
        width="{{ mimg.width }}" height="{{ mimg.height }}"
        fetchpriority="high"
        class="hero__img hero__img--mobile">
    {%- endif -%}
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>
  <div class="hero__content page-padding">
    <div class="hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label-caps hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- else -%}
        <p class="label-caps hero__eyebrow">{{ shop.name | upcase }} / OUTDOOR T-SHIRTS</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="display-lg hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_url }}" class="btn btn--secondary">{{ section.settings.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (leave blank to use shop name)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "MADE TO EXPLORE" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "SHOP T-SHIRTS" },
    { "type": "url", "id": "button_url", "label": "Primary button URL" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label", "default": "EXPLORE COLLECTIONS" },
    { "type": "url", "id": "button_2_url", "label": "Secondary button URL" },
    {
      "type": "range", "id": "height_mobile", "label": "Mobile height (px)", "min": 400, "max": 1000, "step": 1, "unit": "px", "default": 819
    },
    {
      "type": "range", "id": "height_desktop", "label": "Desktop height (px)", "min": 400, "max": 1200, "step": 1, "unit": "px", "default": 921
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
