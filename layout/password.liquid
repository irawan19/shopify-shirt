<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;700&family=Geist:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <style>
      :root { --color-primary:#000; --color-on-primary:#fff; --color-text:#111; --color-surface:#fff; --color-interface:#f7f5f4; --color-hairline:#e5e5e5; --color-muted:#444; --font-heading:'EB Garamond',serif; --font-body:'Geist',sans-serif; --font-mono:'Geist Mono',monospace; }
      *,*::before,*::after{box-sizing:border-box;}
      body{margin:0;background:var(--color-surface);color:var(--color-text);font-family:var(--font-body);-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 20px;text-align:center;}
      h1{font-family:var(--font-heading);font-size:clamp(32px,6vw,56px);line-height:1.1;margin:0 0 16px;font-weight:400;}
      p{color:var(--color-muted);max-width:32rem;margin:0 0 32px;line-height:1.6;}
      .logo{font-family:var(--font-heading);font-size:32px;font-weight:700;letter-spacing:-0.04em;text-transform:uppercase;margin-bottom:32px;}
      .password-form{display:flex;flex-direction:column;gap:16px;width:100%;max-width:360px;}
      .password-form input{padding:16px;border:1px solid var(--color-hairline);background:transparent;font:inherit;}
      .password-form input:focus{outline:0;border-color:var(--color-primary);}
      .password-form button{padding:16px;background:var(--color-primary);color:var(--color-on-primary);border:0;font:inherit;text-transform:uppercase;letter-spacing:0.1em;font-weight:600;font-size:12px;cursor:pointer;}
      .password-form button:hover{opacity:0.8;}
      .owner-link{margin-top:48px;color:var(--color-muted);font-size:12px;letter-spacing:0.1em;text-transform:uppercase;}
      .owner-link a{color:var(--color-primary);border-bottom:1px solid var(--color-primary);}
    </style>
  </head>
  <body>
    <div class="logo">{{ shop.name }}</div>
    {{ content_for_layout }}
    <p class="owner-link">Are you the store owner? <a href="/admin">Log in here</a></p>
  </body>
</html>
