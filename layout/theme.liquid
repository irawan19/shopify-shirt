<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="theme-color" content="{{ settings.color_primary }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_heading_font
      assign mono_font = settings.type_mono_font
    -%}

    {%- style -%}
      :root {
        --color-primary: {{ settings.color_primary | default: '#000000' }};
        --color-on-primary: {{ settings.color_on_primary | default: '#ffffff' }};
        --color-text: {{ settings.color_text | default: '#111111' }};
        --color-surface: {{ settings.color_surface | default: '#ffffff' }};
        --color-interface: {{ settings.color_interface | default: '#f7f5f4' }};
        --color-hairline: {{ settings.color_hairline | default: '#e5e5e5' }};
        --color-coffee: {{ settings.color_coffee | default: '#4a3028' }};
        --color-muted: {{ settings.color_muted | default: '#444748' }};

        --font-body: {{ body_font.family | default: 'Geist' }}, {{ body_font.fallback_families | default: 'sans-serif' }};
        --font-heading: {{ heading_font.family | default: 'EB Garamond' }}, {{ heading_font.fallback_families | default: 'serif' }};
        --font-mono: {{ mono_font.family | default: 'Geist Mono' }}, {{ mono_font.fallback_families | default: 'monospace' }};

        --section-gap: 120px;
        --gutter: 24px;
        --margin-mobile: 20px;
        --margin-desktop: 64px;

        --header-height: 72px;
      }

      {%- if body_font -%}
        {{ body_font | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if heading_font -%}
        {{ heading_font | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if mono_font -%}
        {{ mono_font | font_face: font_display: 'swap' }}
      {%- endif -%}
    {%- endstyle -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Geist:wght@300;400;600&family=Geist+Mono:wght@300;400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'cart.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {{ 'collection.css' | asset_url | stylesheet_tag }}
    {{ 'product.css' | asset_url | stylesheet_tag }}

    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer></script>
    {%- endif -%}

    <script>
      window.routes = {
        cart_url: {{ routes.cart_url | json }},
        cart_add_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        cart_update_url: {{ routes.cart_update_url | json }},
        search_url: {{ routes.search_url | json }},
        root_url: {{ routes.root_url | json }}
      };
      window.Shopify = window.Shopify || {};
      window.Shopify.money_format = {{ shop.money_format | json }};
      window.Shopify.formatMoney = function(cents, format) {
        if (typeof cents === 'string') { cents = cents.replace('.', ''); }
        var value = '';
        var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        var fmt = format || window.Shopify.money_format || '${{amount}}';
        function defaultTo(value, def) { return (value === undefined || value === null) ? def : value; }
        function formatWithDelimiters(number, precision, thousands, decimal) {
          precision = defaultTo(precision, 2);
          thousands = defaultTo(thousands, ',');
          decimal = defaultTo(decimal, '.');
          if (isNaN(number) || number == null) { return 0; }
          number = (number / 100.0).toFixed(precision);
          var parts = number.split('.');
          var dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
          var centsVal = parts[1] ? (decimal + parts[1]) : '';
          return dollars + centsVal;
        }
        switch (fmt.match(placeholderRegex)[1]) {
          case 'amount': value = formatWithDelimiters(cents, 2); break;
          case 'amount_no_decimals': value = formatWithDelimiters(cents, 0); break;
          case 'amount_with_comma_separator': value = formatWithDelimiters(cents, 2, '.', ','); break;
          case 'amount_no_decimals_with_comma_separator': value = formatWithDelimiters(cents, 0, '.', ','); break;
          case 'amount_with_space_separator': value = formatWithDelimiters(cents, 2, ' ', ','); break;
          default: value = formatWithDelimiters(cents, 2);
        }
        return fmt.replace(placeholderRegex, value);
      };
    </script>

    <script src="{{ 'global.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }} bg-surface text-text antialiased">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- render 'cart-drawer' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
